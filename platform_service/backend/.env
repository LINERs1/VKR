# ── Настройки платформы ───────────────────────────
PORT=8001

# ── URL ИИ-сервиса ────────────────────────────────
# Платформа отправляет сюда Webhooks и запросы к joinUrl
AI_SERVICE_URL=http://localhost:8000

# ── База данных ───────────────────────────────────
DATABASE_URL=sqlite:///./platform.db

# ── CORS ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8000

# ── Auth ──────────────────────────────────────────
SECRET_KEY=platform-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================
# LLM PROVIDER — change here to swap models
# =============================================
LLM_PROVIDER=gemini          # "gemini" | "openai" | "ollama"
LLM_MODEL=gemini-2.5-flash   # чат / RAG — быстрее
# ИИ-проверка ДЗ (пусто = LLM_MODEL). Ollama: ollama pull qwen2.5:14b
HOMEWORK_REVIEW_MODEL=

# =============================================
# Google Gemini (если LLM / embeddings = gemini)
# =============================================
GEMINI_API_KEY=

# =============================================
# Ollama (local) — LLM и эмбеддинги идут через Ollama, не через Python
# GPU задаётся в Ollama, не в EduAI. Проверка: ollama ps → PROCESSOR: GPU
# NVIDIA: драйвер + CUDA; при нехватке VRAM Ollama уходит на CPU/RAM
# AMD Windows: часто только CPU; для GPU см. документацию Ollama/ROCm
# OLLAMA_NUM_GPU=99  — сколько слоёв модели на GPU (в среде Ollama)
# =============================================
OLLAMA_BASE_URL=http://127.0.0.1:11434

# =============================================
# OpenAI (cloud) — fill in when switching
# =============================================
OPENAI_API_KEY=

# =============================================
# Embeddings — same provider logic
# =============================================
EMBEDDING_PROVIDER=ollama    # "ollama" | "openai"
EMBEDDING_MODEL=nomic-embed-text

# =============================================
# ChromaDB
# =============================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=course_materials

# =============================================
# TTS — ElevenLabs (optional, browser TTS if empty)
# =============================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# =============================================
# Assistant identity
# =============================================
ASSISTANT_NAME=Кортана
COURSE_NAME=Образовательный курс

# =============================================
# Ultravox (голосовой ассистент: STT + LLM + TTS в облаке)
# https://docs.ultravox.ai/overview
# =============================================
ULTRAVOX_API_KEY=
ULTRAVOX_VOICE_ID=d616943f-cf3e-44e3-9de6-336aaaec86c5
# Скорость голоса: 1.0 норма, 0.85 ≈ −15%, 0.8 ≈ −20% (диапазон ElevenLabs: 0.7–1.2)
ULTRAVOX_VOICE_SPEED=0.85
# Модель голосового ИИ (список: GET /api/ultravox/models после логина)
# Рекомендуется: ultravox-v0.7 (по умолчанию, GLM 4.6)
# Альтернативы: ultravox-v0.6, ultravox-v0.6-llama3.3-70b, ultravox-v0.6-gemma3-27b
ULTRAVOX_MODEL=ultravox-v0.7
# Публичный HTTPS-URL — Ultravox вызывает {BACKEND_PUBLIC_URL}/api/ultravox/rag
# localhost не подходит. В dev (рекомендуется cloudflared):
#   winget install Cloudflare.cloudflared
#   powershell -File backend\scripts\start-tunnel.ps1
# Альтернатива: ngrok 3.20+ (setup-ngrok.ps1 -Authtoken ...)
BACKEND_PUBLIC_URL=http://localhost:8000

# =============================================
# CORS — comma-separated list of allowed origins
# =============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

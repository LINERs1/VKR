# ── LLM ──────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5
HOMEWORK_REVIEW_MODEL=qwen2.5:14b

# ── API Keys ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://127.0.0.1:11434

ULTRAVOX_API_KEY=your_ultravox_api_key_here
ULTRAVOX_VOICE_ID=your_ultravox_voice_id_here
ULTRAVOX_VOICE_SPEED=0.85
ULTRAVOX_MODEL=ultravox-v0.7
BACKEND_PUBLIC_URL=https://boom-smtp-hero-delaware.trycloudflare.com

# ── Embeddings ────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ── TTS ───────────────────────────────────────────
TTS_PROVIDER=xtts
TTS_VOICE=ru-RU-SvetlanaNeural

# ── CORS ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8001

# ── Интеграция с платформой ───────────────────────
# URL платформы — ИИ делает HTTP запросы сюда за данными
PLATFORM_SERVICE_URL=http://localhost:8001

# Порт ИИ-сервиса
PORT=8000

# Скопируйте в docker/compose.env и заполните секреты.
# cp docker/compose.env.example docker/compose.env

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5
HOMEWORK_REVIEW_MODEL=qwen2.5:14b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

GEMINI_API_KEY=

# Ultravox — голос Кортаны (https://app.ultravox.ai)
ULTRAVOX_API_KEY=
ULTRAVOX_VOICE_ID=d616943f-cf3e-44e3-9de6-336aaaec86c5
ULTRAVOX_VOICE_SPEED=0.85
ULTRAVOX_MODEL=ultravox-v0.7

SQLITE_DATABASE_PATH=/data/app.db
CHROMA_PERSIST_DIR=/data/chroma_db
